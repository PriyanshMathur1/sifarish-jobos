{
  "name": "@sifarish/apply-runner",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Runs on the user's own computer: pulls the apply queue, drives hosted ATS forms in a real browser, reports back.",
  "scripts": {
    "start": "tsx src/main.ts",
    "setup": "playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
