# Where your Sifarish runs
SIFARISH_URL=https://sifarish.priyanshmathur.com
# Create on the Apply page ("Create device token"); shown once
SIFARISH_DEVICE_TOKEN=
# Optional overrides
# RUNNER_HEADLESS=false          # keep a visible browser (default false = visible)
# RUNNER_CONFIRM_TIMEOUT_MIN=10  # how long to wait for your click in confirm mode
# RUNNER_BATCH=5                 # attempts per run
# RUNNER_MODE=confirm|handsoff   # override the mode set in the app
