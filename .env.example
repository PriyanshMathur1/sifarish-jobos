# ── Required ────────────────────────────────────────────────
DATABASE_URL=postgres://sifarish:sifarish@localhost:5432/sifarish
AUTH_SECRET=change-me-32-bytes-min-random-string
APP_URL=http://localhost:3000
APP_TZ=Asia/Kolkata
# Twice-daily refresh (cron, evaluated in APP_TZ). Never hardcode in code.
JOB_REFRESH_SCHEDULE=0 3,15 * * *
# Market filter: only ingest jobs eligible for these countries
MARKET_COUNTRIES=IN
# Secret required by the Vercel-cron batch-drain endpoint
CRON_SECRET=change-me

# ── Required in prod, optional in dev ───────────────────────
# Google OAuth (sign-in). Dev can use magic links logged to console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Optional integrations (product boots without all of these)
# Gmail outreach (drafts). Separate OAuth client from sign-in is fine.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# 32-byte hex key for encrypting Gmail tokens at rest
TOKEN_ENCRYPTION_KEY=
# Outbound mailer for prod magic links (dev logs the link instead)
SMTP_URL=
# Hunter.io free tier — single-contact email lookups on the contact page
# (~25/month). Leave blank to disable the "Look up via Hunter.io" button.
HUNTER_API_KEY=

# Alerts (Autopilot). Email alerts reuse SMTP_URL above. For Telegram: create
# a bot with @BotFather, paste its token here, message the bot once, then
# press "Detect my Telegram chat" on the Profile page.
TELEGRAM_BOT_TOKEN=
# From: header for SMTP alerts (default "Sifarish <no-reply@<APP_URL host>>")
NOTIFY_FROM=

# Sign-in emails that get the Admin page (sources, refresh, discovery pages).
# Comma-separated. Applied on first visit; the user's role is then stored.
ADMIN_EMAILS=

# Optional AI opening line on the compose page (LLM_PERSONALISATION flag below)
ANTHROPIC_API_KEY=

# Campaign rails (hard ceilings; campaigns can only ask for less)
CAMPAIGN_DAILY_CAP_MAX=100
CAMPAIGN_PER_COMPANY_14D=2
CAMPAIGN_WARMUP_DAYS=7
CAMPAIGN_WARMUP_DAILY_CAP=10

# ── Feature flags ───────────────────────────────────────────
CONTACT_DISCOVERY=false
OUTREACH_DIRECT_SEND=false
OUTREACH_DAILY_SEND_CAP=25
SEMANTIC_MATCHING=false
EMAIL_NOTIFICATIONS=false
# AI-suggested opening lines and cover letters, always shown before use (needs ANTHROPIC_API_KEY)
LLM_PERSONALISATION=false
