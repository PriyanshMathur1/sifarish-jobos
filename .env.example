# ── Required ────────────────────────────────────────────────
DATABASE_URL=postgres://sifarish:sifarish@localhost:5432/sifarish
AUTH_SECRET=change-me-32-bytes-min-random-string
APP_URL=http://localhost:3000
APP_TZ=Asia/Kolkata
# Twice-daily refresh (cron, evaluated in APP_TZ). Never hardcode in code.
JOB_REFRESH_SCHEDULE=0 3,15 * * *
# Market filter: only ingest jobs eligible for these countries
MARKET_COUNTRIES=IN
# Secret required by the Vercel-cron batch-drain endpoint
CRON_SECRET=change-me

# ── Required in prod, optional in dev ───────────────────────
# Google OAuth (sign-in). Dev can use magic links logged to console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Optional integrations (product boots without all of these)
# Gmail outreach (drafts). Separate OAuth client from sign-in is fine.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# 32-byte hex key for encrypting Gmail tokens at rest
TOKEN_ENCRYPTION_KEY=
# Outbound mailer for prod magic links (dev logs the link instead)
SMTP_URL=

# ── Feature flags ───────────────────────────────────────────
CONTACT_DISCOVERY=false
OUTREACH_DIRECT_SEND=false
OUTREACH_DAILY_SEND_CAP=25
SEMANTIC_MATCHING=false
EMAIL_NOTIFICATIONS=false
